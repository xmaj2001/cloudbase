@baseUrl = http://localhost:5000/v1
@email = dev@cloudbase.com
@password = SenhaSegura123!

### 1. Criar Utilizador (Sign Up)
# @name signUp
POST {{baseUrl}}/auth/sign-up
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}",
  "name": "Developer CloudBase"
}

###

### 2. Fazer Login (Sign In)
# @name signIn
POST {{baseUrl}}/auth/sign-in
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}"
}

### Capturar o Token da Sessão
@authToken = {{signIn.response.body.data.token}}
@userId = {{signIn.response.body.data.user.id}}

###

### 3. Obter Sessão Atual (Me)
GET {{baseUrl}}/auth/me
Authorization: Bearer {{authToken}}

### 6. Listar Providers
## @name providers
GET {{baseUrl}}/providers
Authorization: Bearer {{authToken}}

@providerId = dc6321a4-1533-42aa-8a22-fd5ae55e8066


### 1. Criar uma Pasta (Folder) na Raiz
# @name createFolder
POST {{baseUrl}}/nodes
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "name": "Max",
  "type": "FOLDER",
  "providerId": "{{providerId}}"
  
  
}

### Guardar o ID da pasta criada
@folderId = {{createFolder.response.body.data.id}}

###

### 2. Criar um Ficheiro Simples (Sem Fragmentação)
# @name createFileSimple
POST {{baseUrl}}/nodes
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "name": "documento_projeto.pdf",
  "type": "FILE",
  "mimeType": "application/pdf",
  "extension": "pdf",
  "size": "52428800",
  "isFragmented": false,
  "totalChunks": 1,
  "originalHash": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
  "providerId": "{{providerId}}",
  "providerFileId": "gdrive_file_id_9988",
  "providerPath": "CloudBase/documento_projeto.pdf"
}

###

### 3. Criar um Ficheiro Fragmentado (Com Chunks/Partes)
# @name createFileFragmented
POST {{baseUrl}}/nodes
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "name": "photoshop.zip",
  "type": "FILE",
  "mimeType": "application/zip",
  "extension": "zip",
  "size": "17000000000",
  "isFragmented": true,
  "totalChunks": 2,
  "originalHash": "8f4e3c2b1a5d6e7f8a9b0c1d2e3f4a5b",
  "providerId": "{{providerId}}",
  "parentId": "1d278140-d287-45c9-a071-9f537b0c03c7",
  "chunks": [
    {
      "chunkIndex": 0,
      "size": "16106127360",
      "startByte": "0",
      "endByte": "16106127360",
      "chunkHash": "hash_part_0_abc123",
      "providerId": "{{providerId}}",
      "providerFileId": "gdrive_part_001",
      "providerPath": "CloudBase/_fragments/filme_4k.zip.part0"
    },
    {
      "chunkIndex": 1,
      "size": "893872640",
      "startByte": "16106127360",
      "endByte": "17000000000",
      "chunkHash": "hash_part_1_xyz789",
      "providerId": "{{providerId}}",
      "providerFileId": "gdrive_part_001",
      "providerPath": "CloudBase/_fragments/filme_4k.zip.part1"
    }
  ]
}

### Guardar o ID do ficheiro fragmentado
@nodeId = {{createFileFragmented.response.body.data.id}}

###

### 4. Listar Conteúdo da Raiz (parentId não enviado)
GET {{baseUrl}}/nodes
Authorization: Bearer {{authToken}}

###

### 5. Listar Conteúdo Dentro de uma Pasta Específica
GET {{baseUrl}}/nodes?parentId=1d278140-d287-45c9-a071-9f537b0c03c7
Authorization: Bearer {{authToken}}

###

### 6. Obter Detalhes Completos de um Node (Incluindo Chunks e Providers)
GET {{baseUrl}}/nodes/{{nodeId}}
Authorization: Bearer {{authToken}}

###

### 7. Mover Ficheiro/Pasta para a Reciclagem (Trash)
DELETE {{baseUrl}}/nodes/{{nodeId}}/trash
Authorization: Bearer {{authToken}}
