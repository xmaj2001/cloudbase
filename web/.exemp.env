# ==============================================================================
# ENVIRONMENT & URL CONFIGURATION
# ==============================================================================
# A URL onde este próprio frontend Next.js está rodando
NEXT_PUBLIC_URL="http://localhost:3000"

# A URL base do seu backend NestJS (onde as rotas de API e Auth estão hospedadas)
BACKEND_URL="http://localhost:5000"

# ==============================================================================
# BETTER AUTH - CLIENT CONFIGURATION
# ==============================================================================
# O Better Auth Client precisa saber onde fica o servidor de autenticação (seu backend NestJS)
# Se você configurou o endpoint do Better Auth no NestJS em /api/auth, a URL será esta:
BETTER_AUTH_URL="http://localhost:5000"
BETTER_AUTH_SECRET=""
# ==============================================================================
# OAUTH PROVIDERS (FRONTEND ONETAP / SIGN IN)
# ==============================================================================
# Como você ativou o plugin 'oneTap' no backend, o componente do Google One Tap 
# no Next.js vai precisar do Client ID exposto no frontend para renderizar o prompt nativo.
NEXT_PUBLIC_GOOGLE_CLIENT_ID="seu_google_client_id_aqui.apps.googleusercontent.com"