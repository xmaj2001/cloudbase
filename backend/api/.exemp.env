# ==============================================================================
# SERVER CONFIGURATION
# ==============================================================================
PORT=5000

# ==============================================================================
# DATABASES & CACHE
# ==============================================================================
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"
REDIS_URL="redis://default:PASSWORD@HOST:PORT"

# ==============================================================================
# BETTER AUTH CONFIGURATION
# ==============================================================================
# A URL base da sua API onde o Better Auth está rodando (ex: http://localhost:3000)
BETTER_AUTH_URL="http://localhost:5000"

# Um segredo aleatório de 32 caracteres para encriptar os tokens/sessões.
# Você pode gerar um rodando: openssl rand -base64 32 no terminal
BETTER_AUTH_SECRET="seu_secret_super_seguro_com_32_caracteres_aqui"

# ==============================================================================
# OAUTH PROVIDERS (GOOGLE)
# ==============================================================================
GOOGLE_CLIENT_ID="seu_google_client_id_aqui.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="seu_google_client_secret_aqui"